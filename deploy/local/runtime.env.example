# Copy to runtime.env (ignored by Git); fill values privately.
# Use the existing database name and restricted platform_app credentials.
# For PostgreSQL on your laptop, use host.minikube.internal, NOT localhost.
# PostgreSQL must listen on an interface reachable from Minikube, with pg_hba.conf
# allowing only the needed Minikube network and restricted database user.
# Alternatively use your existing Neon URL with sslmode=require.
DATABASE_URL=postgres://platform_app:replace_me@host.minikube.internal:5432/interview-platform
INVITATION_ENCRYPTION_KEY=replace_with_your_existing_64_hex_character_key
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
WEBRTC_ICE_SERVERS=[]
