# DATABASE — one setting used by the API, migrations and database tests.
# The backend loads backend/.env automatically; shell variables take precedence.
# For the API, use platform_app (non-superuser, NOBYPASSRLS).
DATABASE_URL=postgres://platform_app:replace_me@localhost:5432/interview-platform
# Migrations need the database owner's credentials. Override DATABASE_URL for that
# command only; do not change the API's saved connection to an owner/superuser.
# Integration tests write/delete data: override DATABASE_URL to a disposable DB.
# GitHub Actions supplies its own temporary PostgreSQL URL; never add Neon to CI.

# SERVER — localhost for development; containers set 0.0.0.0:8080.
BIND_ADDRESS=127.0.0.1:8080
RUST_LOG=info,tower_http=info
ALLOW_REGISTRATION=true
FRONTEND_ORIGIN=http://localhost:5173

# SECURITY — disable registration after provisioning interviewers in production.
# Stable random 32-byte key as 64 hex characters. Back up privately; do not rotate blindly.
# Generate with: openssl rand -hex 32
INVITATION_ENCRYPTION_KEY=replace_with_64_hex_characters

# AI — generation, scoring and semantic search. Keys stay server-side.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# Optional private recording storage (default: backend/storage/media).
# Back up alongside PostgreSQL; never serve this directory as public assets.
# MEDIA_STORAGE_DIR=/absolute/private/path/interview-media

# Per model request during question/reference generation (30–300 seconds).
# GENERATION_REQUEST_TIMEOUT_SECONDS=180

# gpt-5-mini blueprint/prompt/reference drafting effort; reference quality review uses medium.
# Values: minimal|low|medium|high.
# GENERATION_DRAFT_REASONING_EFFORT=low

# Sequential generation: finish and save one validated question before the next.
# Per-question preparation budget, 30–900 seconds (default 300).
# Failures receive three automatic retries; saved questions survive retries.
# Manual retry is available after those attempts are exhausted.
# GENERATION_TASK_TIMEOUT_SECONDS=300

# WebRTC ICE servers (JSON). Empty works on reachable local networks.
# For remote networks configure STUN and a TURN server with short-lived credentials.
WEBRTC_ICE_SERVERS=[]
