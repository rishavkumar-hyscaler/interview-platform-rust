# Existing local PostgreSQL. The backend automatically loads this file.
# DATABASE_URL is the migration/admin connection when RUNTIME_DATABASE_URL is set.
DATABASE_URL=postgres://postgres:replace_me@localhost:5432/interview-platform
# Runtime must be a non-superuser role without BYPASSRLS; provision platform_app first.
RUNTIME_DATABASE_URL=postgres://platform_app:replace_me@localhost:5432/interview-platform
# Optional: defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgres://postgres:replace_me@localhost:5432/interview-platform
BIND_ADDRESS=127.0.0.1:8080
RUST_LOG=info,tower_http=info
ALLOW_REGISTRATION=true
FRONTEND_ORIGIN=http://localhost:5173

# Stable random 32-byte key as 64 hex characters. Back up privately; do not rotate blindly.
# Generate with: openssl rand -hex 32
INVITATION_ENCRYPTION_KEY=replace_with_64_hex_characters

# Question generation and semantic deduplication. Keys stay server-side.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# Optional private recording storage (default: backend/storage/media).
# Back up alongside PostgreSQL; never serve this directory as public assets.
# MEDIA_STORAGE_DIR=/absolute/private/path/interview-media

# Per model request during question/reference generation (30–300 seconds).
# GENERATION_REQUEST_TIMEOUT_SECONDS=180

# gpt-5-mini blueprint/question drafting effort (minimal|low|medium|high); quality review uses medium.
# GENERATION_DRAFT_REASONING_EFFORT=low
