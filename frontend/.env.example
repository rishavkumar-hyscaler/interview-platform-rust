# Local development uses Vite's same-origin proxy. Leave this blank.
VITE_API_BASE_URL=
API_PROXY_TARGET=http://127.0.0.1:8080
# For a separately hosted production API, set VITE_API_BASE_URL to its HTTPS URL.

# Browser console: debug in development, warn in production by default.
# VITE_LOG_LEVEL=debug

# Media proctoring assets are generated locally by npm run setup:proctoring.
# No external camera/audio analysis endpoint or API key is required.
